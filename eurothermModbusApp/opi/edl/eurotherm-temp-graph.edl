# (Static Text)
object activeXTextClass
beginObjectProperties
major 4
minor 1
release 1
x 10
y 5
w 480
h 30
font "arial-medium-r-18.0"
fontAlign "center"
fgColor index 14
bgColor index 8
value {
  "$(device): $(label)"
}
border
endObjectProperties

# (X-Y Graph)
object xyGraphClass
beginObjectProperties
major 4
minor 8
release 0
# Geometry
x 10
y 39
w 480
h 248
# Appearance
xLabel "Time (s)"
yLabel "Temperature (C)"
fgColor index 13
bgColor index 7
gridColor index 33
font "arial-medium-r-14.0"
# Operating Modes
plotMode "plotLastNPts"
nPts 2000
updateTimerMs 100
# X axis properties
showXAxis
xAxisStyle "time"
xAxisSrc "AutoScale"
xMax 1
xShowLabelGrid
# Y axis properties
showYAxis
yAxisSrc "AutoScale"
yMax 1
# Y2 axis properties
y2AxisSrc "AutoScale"
y2Max 1
# Trace Properties
numTraces 1
yPv {
  0 "$(device):$(loop):PV:RBV"
}
plotColor {
  0 index 36
}
endObjectProperties

