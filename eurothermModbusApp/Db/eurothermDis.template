
record(calc, "$(device):READ_ERR_CNT")
{
    field(DESC, "Num of read errors since last ok read")
    field(INPA, "$(device):LOOP1:PV:RBV.SEVR")
    field(INPB, "$(device):READ_ERR_CNT")
    field(INPC, "$(device):DISABLE")
    # Reset counter when device disabled, reset when read ok, increment when read error
    field(CALC, "(C=1)? 0 : ((A=0)? 0 : B+1)")
    field(VAL, "0")
    field(SCAN,"Passive")
}

# Disable polling after ~5 consecutive read errors
# Before the counter was implemented, occasional read errors would cause polling to disable.
record(calcout, "$(device):AUTODISABLE")
{
    field(CALC, "A>5")
    field(DESC, "Disable polling in case of read errors")
    field(INPA, "$(device):READ_ERR_CNT")
    field(OOPT, "When Non-zero")
    field(DOPT, "Use OCAL")
    field(OCAL, "1")
    field(OUT,  "$(device):DISABLE PP")
    field(SCAN, "5 second")
}

record(bi, "$(device):DISABLE")
{
    field(DESC, "Enable/Disable polling")
    field(ZNAM, "Enabled")
    field(ONAM, "Disabled")
    field(SCAN, "Passive")
    field(VAL,  "1")
    field(FLNK, "$(device):READ_ERR_CNT")
}
alias($(device):DISABLE,$(device):LOOP1:DISABLE)
alias($(device):DISABLE,$(device):LOOP2:DISABLE)
