{
    field(DESC, "Update Temp Params")
    field(SCAN, "Passive")
    field(PINI, "YES")
    field(DOL1, "$(device):$(loop_name):SP:HIGH.VAL")
    field(DOL2, "$(device):$(loop_name):SP:LOW.VAL")
    field(LNK1, "$(device):$(loop_name):SP.DRVH")
    field(LNK2, "$(device):$(loop_name):SP.DRVL")
}


#% autosave 0 VAL
record(mbbo, "$(device):$(loop_name):SP:TRACKOL") {
  field(DESC, "Enable CL setpoint to track OL temp.")
  field(ZRST, "Disabled")
  field(ZRVL, "0")
  field(ONST, "Enabled")
  field(ONVL, "1")
  field(PINI, "YES")
}

record(calcout, "$(device):$(loop_name):SP:TRACKCLC") {
  field(DESC, "If tracking enabled & open_loop")
  field(CALC, "(A=1&&B=1)?1:0")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use OCAL")
  field(OCAL, "C")
  field(INPA, "$(device):$(loop_name):SP:TRACKOL")
  field(INPB, "$(device):$(loop_name):MAN:RBV")
  field(INPC, "$(device):$(loop_name):PV:RBV")
  field(OUT, "$(device):$(loop_name):SP PP")
  field(FLNK, "$(device):READ_ERR_CNT")
}
