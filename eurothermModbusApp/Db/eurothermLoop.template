# % macro, device, device prefix
# % macro, modbus_prefix, modbus prefix
# % macro, loop_name, loop name to be used in PVs. i.e. LOOP1, LOOP2 
# % macro, rregu, Ramprate EGU
# Addresses: (Loop2 usually is Loop1 + 1024)
# % macro, autotune_addr,       LOOP1: 270,    LOOP2: 1294
# % macro, derivative_addr,     LOOP1: 9,      LOOP2: 1033
# % macro, integral_addr,       LOOP1: 8,      LOOP2: 1032
# % macro, mode_addr,           LOOP1: 273,    LOOP2: 1297
# % macro, output_addr,         LOOP1: 3,      LOOP2: 1027
# % macro, outputhi_addr,       LOOP1: 30,     LOOP2: 1054
# % macro, outputlo_addr,       LOOP1: 31,     LOOP2: 1055
# % macro, proportional_addr,   LOOP1: 6,      LOOP2: 1030
# % macro, temperature_addr,    LOOP1: 1,      LOOP2: 1025
# % macro, ramprate_addr,       LOOP1: 35,     LOOP2: 1059
# % macro, setpoint_addr,       LOOP1: 2,      LOOP2: 1026
# % macro, working_setpoint_addr, LOOP1: 5,    LOOP2: 1029

# % macro, setpoint_limitHI_addr, LOOP1: 111,    LOOP2: 113
# % macro, setpoint_limitLO_addr, LOOP1: 112,    LOOP2: 114

# macro, ramprate_units_addr, LOOP1: 531,    LOOP2: 1555




record(bo, "$(device):$(loop_name):AUTOTUNE")
{
    field(DTYP, "asynUInt32Digital")
    field(ONAM, "On")
    field(OUT,  "@asynMask($(modbus_prefix)_MASTER_TX,$(autotune_addr),1,1000)MODBUS_DATA")
    field(SDIS, "$(device):DISABLE")
    field(ZNAM, "Off")
}

record(bi, "$(device):$(loop_name):AUTOTUNE:RBV")
{
    field(DESC, "autotune")
    field(DTYP, "asynUInt32Digital")
    field(INP,  "@asynMask($(modbus_prefix)_MASTER_RX,$(autotune_addr),1,1000)MODBUS_DATA")
    field(ONAM, "On")
    field(SCAN, "1 second")
    field(SDIS, "$(device):DISABLE")
    field(ZNAM, "Off")
}


